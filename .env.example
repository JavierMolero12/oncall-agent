# Copy this file to .env and fill in the secrets. Never commit .env.

# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Fine-grained GitHub token: only JavierMolero12/gitops-manifests,
# Contents + Pull requests read/write.
GITHUB_TOKEN=

# Optional overrides (these are the defaults)
ONCALL_MODEL=claude-sonnet-5-5
ONCALL_MAX_STEPS=15
GITOPS_REPO=JavierMolero12/gitops-manifests
GITOPS_BRANCH=main
KUBE_CONTEXT=k3d-gitops-demo
ARGOCD_NAMESPACE=argocd
